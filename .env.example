# Canonical site URL — set this on Vercel so metadata, sitemap and JSON-LD
# point at the real domain instead of the placeholder.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery (optional).
# Without RESEND_API_KEY the form stays functional but falls back to opening
# the visitor's mail client with a prefilled draft — it never silently drops
# a message. Add a key from https://resend.com to deliver server-side.
RESEND_API_KEY=
CONTACT_TO_EMAIL=anasabdelazim602@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
